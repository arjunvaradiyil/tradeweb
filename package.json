{
  "name": "tradmaxacademy",
  "version": "1.0.0",
  "description": "Trademax Academy website - Next.js + Payload CMS",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/dummy.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@react-three/fiber": "^9.1.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "next": "16.4.5",
    "payload": "3.93.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.34.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.170.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@swc/core"
    ]
  }
}
